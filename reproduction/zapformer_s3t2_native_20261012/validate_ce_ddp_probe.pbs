#!/bin/bash
#PBS -N native_ce_ddp
#PBS -q debug-g
#PBS -W group_list=gm64
#PBS -l select=2:ncpus=32:mpiprocs=1
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o /work/gm64/m64000/OTTC/reproduction/zapformer_s3t2_native_20261012/validation_ce_ddp_probe.log
set -euo pipefail
cd /work/gm64/m64000/OTTC
task_dir=/work/gm64/m64000/OTTC/reproduction/zapformer_s3t2_native_20261012
test -s "$task_dir/validation_ce_probe/PARTIAL_PASS.json"
source "$task_dir/environment.sh"
mkdir -p "$task_dir/validation_ce_ddp_probe"
awk '!seen[$0]++' "${PBS_NODEFILE:?}" > "$task_dir/validation_ce_ddp_probe/nodes"
IFS= read -r S3T2_MASTER_ADDR < "$task_dir/validation_ce_ddp_probe/nodes"
export S3T2_MASTER_ADDR S3T2_TEST_NODES=2 S3T2_VALIDATION_OBJECTIVES=framece
export S3T2_VALIDATION_ROOT="$task_dir/validation_ce_ddp_probe"
export S3T2_MASTER_PORT=$((29500 + ${PBS_JOBID%%.*} % 1000))
export OMPI_MCA_mca_base_env_list='S3T2_MASTER_ADDR;S3T2_MASTER_PORT;S3T2_TEST_NODES;S3T2_VALIDATION_OBJECTIVES;S3T2_VALIDATION_ROOT'
mpirun -np 2 --hostfile "$task_dir/validation_ce_ddp_probe/nodes" --map-by ppr:1:node --bind-to none bash "$task_dir/validate_ddp_worker.sh"
"$MFA_PYTHON" "$task_dir/validate.py" --compare-root "$task_dir/validation_ce_ddp_probe" --objectives framece
