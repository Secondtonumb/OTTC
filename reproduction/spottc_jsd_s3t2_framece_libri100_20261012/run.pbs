#!/bin/bash
#PBS -N s3t2_jsd_lib100_fce
#PBS -q regular-g
#PBS -W group_list=gm64
#PBS -l select=4:ncpus=16:mpiprocs=1
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /work/gm64/m64000/OTTC/reproduction/spottc_jsd_s3t2_framece_libri100_20261012/dispatch.log
set -euo pipefail
cd /work/gm64/m64000/OTTC
task_dir=$PWD/reproduction/spottc_jsd_s3t2_framece_libri100_20261012
test -s "$task_dir/validation/SMOKE_PASS.json"
test -s "$task_dir/data/PREPARE_COMPLETE.json"
sha256sum -c "$task_dir/runtime.sha256"
mkdir -p "$task_dir/training"
exec 9> "$task_dir/training/.training.lock"
flock 9
if [[ -f "$task_dir/training/TRAIN_COMPLETE.json" ]]; then exit 0; fi
awk '!seen[$0]++' "${PBS_NODEFILE:?}" > "$task_dir/training/nodes"
IFS= read -r FRAMECE_MASTER_ADDR < "$task_dir/training/nodes"
export FRAMECE_MASTER_ADDR
export FRAMECE_MASTER_PORT=$((29500 + ${PBS_JOBID%%.*} % 1000))
export OMPI_MCA_mca_base_env_list='FRAMECE_MASTER_ADDR;FRAMECE_MASTER_PORT;PATH;LD_LIBRARY_PATH;WANDB_MODE'
mpirun -np 4 --hostfile "$task_dir/training/nodes" --map-by ppr:1:node --bind-to none \
  bash "$task_dir/worker.sh"
source "$task_dir/environment.sh"
if [[ -s "$task_dir/training/TRAIN_COMPLETE.json" ]]; then
  echo 'CE stabilization complete'
else
  /opt/pbs/bin/qsub "$task_dir/run.pbs" > "$task_dir/training/continuation_job.txt"
fi
