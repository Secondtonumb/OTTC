#!/bin/bash
#PBS -N buckeye_frameag
#PBS -q regular-g
#PBS -W group_list=gm64
#PBS -l select=1:ncpus=32:mpiprocs=1
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail
cd /work/gm64/m64000/OTTC
source reproduction/libri960_continue5_20261017/environment.sh
export CUDA_VISIBLE_DEVICES=0 OTTC_EVAL_UPLOAD=0
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export WANDB_RUN_GROUP=buckeye_frame_ag_20261027
unset RANK WORLD_SIZE LOCAL_RANK LOCAL_WORLD_SIZE MASTER_ADDR MASTER_PORT
run_root="$PWD/reproduction/buckeye_frame_ag_20261027"
run_evidence="$run_root/jobs/${PBS_JOBID:?}"
mkdir -p "$run_evidence"
exec >> "$run_evidence/worker.log" 2>&1
export WANDB_CACHE_DIR="$run_evidence/wandb_cache" WANDB_DATA_DIR="$run_evidence/wandb_data"
qstat -f "$PBS_JOBID" > "$run_evidence/pbs_start.txt" || true
git rev-parse HEAD > "$run_evidence/git_commit.txt"
nvidia-smi --query-gpu=timestamp,index,utilization.gpu,memory.used,power.draw --format=csv -l 10 \
    >> "$run_evidence/telemetry.csv" &
run_monitor=$!
finish() {
    run_exit=$?
    kill "$run_monitor" 2>/dev/null || true
    printf '{"exit_code":%s}\n' "$run_exit" > "$run_evidence/EXIT.json"
    exit "$run_exit"
}
trap finish EXIT
"$LIBRI_PYTHON" -u -m reproduction.buckeye_frame_ag_20261027.train --recipe frame_ag__seed42 --profile
"$LIBRI_PYTHON" -u -m reproduction.buckeye_frame_ag_20261027.train --recipe frame_ag__seed42 --max-seconds 21600
"$LIBRI_PYTHON" -u -m reproduction.buckeye_frame_ag_20261027.report
