#!/bin/bash
#PBS -N timit_frame3
#PBS -q regular-g
#PBS -W group_list=gm64
#PBS -l select=3:ncpus=32:mpiprocs=1
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
cd /work/gm64/m64000/OTTC
source reproduction/libri960_continue5_20261017/environment.sh
root="$PWD/reproduction/timit_frame_divergences_20261026"
allocation="$root/jobs/${PBS_JOBID:?}"
mkdir -p "$allocation"
awk '!seen[$0]++' "${PBS_NODEFILE:?}" > "$allocation/nodes"
test "$(wc -l < "$allocation/nodes")" -eq 3
case ${FRAME_DIV_COST:?} in jsd_standard|jdiv|ag) ;; *) exit 2 ;; esac
git rev-parse HEAD > "$allocation/git_commit.txt"
git diff --binary > "$allocation/tracked_worktree.patch"
qstat -f "$PBS_JOBID" > "$allocation/pbs_start.txt" || true
export FRAME_DIV_DEADLINE=$(( $(date +%s) + 7200 ))
export OMPI_MCA_mca_base_env_list='FRAME_DIV_COST;FRAME_DIV_DEADLINE;PBS_JOBID'
mpirun -np 3 --hostfile "$allocation/nodes" --map-by ppr:1:node --bind-to none \
    bash "$root/worker.sh"
"$LIBRI_PYTHON" -B -m reproduction.timit_frame_divergences_20261026.report
"$LIBRI_PYTHON" -B - "$allocation" "$FRAME_DIV_COST" <<'PY'
import json
from pathlib import Path
import sys
allocation, cost = Path(sys.argv[1]), sys.argv[2]
names = [f'frame_{cost}__seed{s}' for s in (42, 43, 44)]
workers = [json.loads((allocation / name / 'WORKER_EXIT.json').read_text()) for name in names]
complete = all(w['exit_code'] == 0 for w in workers) and all(
    (allocation.parents[1] / 'models' / name / 'BENCHMARK_COMPLETE.json').exists() for name in names)
status = dict(cost=cost, workers=workers, complete=complete, independent_seeds=True, GPUs=3)
(allocation / 'ALLOCATION_STATUS.json').write_text(json.dumps(status, indent=2) + '\n')
if complete:
    (allocation / 'ALLOCATION_COMPLETE.json').write_text(json.dumps(status, indent=2) + '\n')
assert complete, 'At least one seed failed or paused; inspect individual logs/checkpoints'
PY
