#!/bin/bash
#PBS -N libri960_continue5
#PBS -q regular-g
#PBS -W group_list=gm64
#PBS -l select=1:ncpus=32:mpiprocs=1
#PBS -l walltime=24:00:00
#PBS -j oe
set -euo pipefail
cd /work/gm64/m64000/OTTC
source reproduction/libri960_continue5_20261017/environment.sh
objective=${LIBRI_OBJECTIVE:?Specify ce, jsd_upstream or jsd_standard}
export LIBRI960_DEADLINE=$(($(date +%s)+79200))
bash reproduction/libri960_continue5_20261017/worker.sh "$objective" validate \
    >> "reproduction/libri960_continue5_20261017/validate_${objective}.log" 2>&1
status=0
bash reproduction/libri960_continue5_20261017/worker.sh "$objective" train \
    >> "reproduction/libri960_continue5_20261017/train_${objective}.log" 2>&1 || status=$?
printf '%s\n' "$status" > "reproduction/libri960_continue5_20261017/train_${objective}_exit_code.txt"
exit "$status"
