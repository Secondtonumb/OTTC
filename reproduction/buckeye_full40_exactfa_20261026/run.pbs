#!/bin/bash
#PBS -N buckeye_exactFA
#PBS -q regular-g
#PBS -W group_list=gm64
#PBS -l select=12:ncpus=16:mpiprocs=1
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
cd /work/gm64/m64000/OTTC
source reproduction/libri960_continue5_20261017/environment.sh
root="$PWD/reproduction/buckeye_full40_exactfa_20261026"
allocation="$root/jobs/${PBS_JOBID:?}"
mkdir -p "$allocation"
finish() { status=$?; printf '{"job_id":"%s","exit_code":%s}\n' "$PBS_JOBID" "$status" > "$allocation/EXIT.json"; }
trap finish EXIT
awk '!seen[$0]++' "${PBS_NODEFILE:?}" > "$allocation/nodes"
test "$(wc -l < "$allocation/nodes")" -eq 12
export OMPI_MCA_mca_base_env_list='PBS_JOBID'
mpirun -np 12 --hostfile "$allocation/nodes" --map-by ppr:1:node --bind-to none bash "$root/worker.sh"
"$LIBRI_PYTHON" -m reproduction.buckeye_full40_exactfa_20261026.report
