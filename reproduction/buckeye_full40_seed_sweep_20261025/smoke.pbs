#!/bin/bash
#PBS -N buckeye40_smoke
#PBS -q regular-g
#PBS -W group_list=gm64
#PBS -l select=12:ncpus=32:mpiprocs=1
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
cd /work/gm64/m64000/OTTC
source reproduction/libri960_continue5_20261017/environment.sh
root="$PWD/reproduction/buckeye_full40_seed_sweep_20261025"
allocation="$root/jobs/${PBS_JOBID:?}"
mkdir -p "$allocation"
awk '!seen[$0]++' "${PBS_NODEFILE:?}" > "$allocation/nodes"
test "$(wc -l < "$allocation/nodes")" -eq 12
export OMPI_MCA_mca_base_env_list='PBS_JOBID'
mpirun -np 12 --hostfile "$allocation/nodes" --map-by ppr:1:node --bind-to none bash "$root/worker.sh" --smoke
"$LIBRI_PYTHON" -m reproduction.buckeye_full40_seed_sweep_20261025.submit --submit