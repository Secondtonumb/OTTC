#!/usr/bin/env bash
#PBS -N fourhead_ckpt_compare
#PBS -q debug-g
#PBS -W group_list=gm64
#PBS -l select=1:ncpus=16:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
cd /work/gm64/m64000/OTTC
export PYTHONPATH=/work/gm64/m64000/OTTC/reproduction/vendor:/work/gm64/m64000/OTTC
export LD_LIBRARY_PATH=/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/lib:${LD_LIBRARY_PATH:-}
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 OMP_NUM_THREADS=4 CUDA_VISIBLE_DEVICES=0
export WANDB_MODE=online WANDB_LOG_MODEL=false WANDB_WATCH=false
task_python=/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/bin/python
arguments=(--plan "${COMPARISON_PLAN:?}")
if [[ "${COMPARISON_LIMIT:-0}" != 0 ]]; then arguments+=(--limit "$COMPARISON_LIMIT"); fi
"$task_python" -u reproduction/compare_multihead_checkpoints.py "${arguments[@]}"
