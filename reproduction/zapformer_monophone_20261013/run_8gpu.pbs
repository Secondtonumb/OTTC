#!/bin/bash
#PBS -N ottc_mono105_8
#PBS -q regular-g
#PBS -W group_list=gm64
#PBS -l select=8:ncpus=32:mpiprocs=1:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /work/gm64/m64000/OTTC/reproduction/zapformer_monophone_20261013/train_8gpu.log
set -euo pipefail
cd /work/gm64/m64000/OTTC
mono_stage=/work/gm64/m64000/OTTC/reproduction/zapformer_monophone_20261013
source reproduction/zapformer_s3t2ss_native_20261012/environment.sh
"$MFA_PYTHON" - <<'PY'
import json,hashlib
from pathlib import Path
p=Path('reproduction/zapformer_monophone_20261013')
proof=json.loads((p/'DDP_RESUME_PASS.json').read_text())
assert proof['world_size']==8 and proof['head_dimension']==105
assert proof['model_optimizer_average_scheduler_all_rank_rng_bitwise_equal']
for name,digest in proof['source_sha256'].items():
    assert hashlib.sha256((p/name).read_bytes()).hexdigest()==digest, name
assert (p/'COMPLETE.json').exists()
PY
mkdir -p "$mono_stage/training"
exec 9> "$mono_stage/training/.training.lock"
flock -n 9 || exit 1
if [[ -s "$mono_stage/training/TRAIN_COMPLETE.json" ]]; then exit 0; fi
awk '!seen[$0]++' "${PBS_NODEFILE:?}" > "$mono_stage/training/nodes"
test "$(wc -l < "$mono_stage/training/nodes")" -eq 8
IFS= read -r MONO_MASTER < "$mono_stage/training/nodes"
export MONO_MASTER MONO_PORT=$((29500 + ${PBS_JOBID%%.*} % 1000))
export WANDB_MODE="${WANDB_MODE:-online}" MONO_EPOCHS="${MONO_EPOCHS:-10}"
export WANDB_CACHE_DIR="$mono_stage/wandb_cache"
export OMPI_MCA_mca_base_env_list='MONO_MASTER;MONO_PORT;MONO_EPOCHS;WANDB_MODE;WANDB_PROJECT;WANDB_ENTITY;WANDB_CACHE_DIR'
mpirun -np 8 --hostfile "$mono_stage/training/nodes" --map-by ppr:1:node --bind-to none \
  bash "$mono_stage/train_worker.sh"
if [[ ! -s "$mono_stage/training/TRAIN_COMPLETE.json" ]]; then
  /opt/pbs/bin/qsub -v "MONO_EPOCHS=$MONO_EPOCHS" -W "depend=afterok:${PBS_JOBID:?}" \
    "$mono_stage/run_8gpu.pbs" >> "$mono_stage/training/continuations_8gpu.txt"
fi
