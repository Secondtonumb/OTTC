#!/bin/bash
#PBS -N mono_preflight
#PBS -q regular-g
#PBS -W group_list=gm64
#PBS -l select=1:ncpus=32:mpiprocs=1
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o /work/gm64/m64000/OTTC/reproduction/zapformer_monophone_20261013/validate_single.log
set -euo pipefail
cd /work/gm64/m64000/OTTC
source reproduction/zapformer_s3t2ss_native_20261012/environment.sh
export WANDB_MODE=offline CUDA_VISIBLE_DEVICES=0
mono_stage=/work/gm64/m64000/OTTC/reproduction/zapformer_monophone_20261013
for mono_pass in uninterrupted resumed_first resumed_second; do
  mono_steps=2;mono_run=$mono_pass
  if [[ "$mono_pass" == resumed_first ]]; then mono_steps=1;mono_run=resumed;fi
  if [[ "$mono_pass" == resumed_second ]]; then mono_run=resumed;fi
  "$MFA_PYTHON" -m torch.distributed.run --standalone --nproc_per_node 1 \
    "$mono_stage/train_native.py" --objective jsd --topology s1_t1 \
    --output "$mono_stage/validation_single/$mono_run" --smoke --epochs 10 \
    --base-lr .03423791569515573 --stop-after "$mono_steps" --max-duration 100 \
    --save-every 1 --eval-every 1 --average-period 2 --eval-limit 8
done
"$MFA_PYTHON" - <<'PY'
import sys,json
from pathlib import Path
p=Path('reproduction/zapformer_monophone_20261013')
sys.path.insert(0,str(p));from check_validation import torch,identical
a=torch.load(p/'validation_single/uninterrupted/step-000000002.pt',map_location='cpu',mmap=True,weights_only=False)
b=torch.load(p/'validation_single/resumed/step-000000002.pt',map_location='cpu',mmap=True,weights_only=False)
for key in ['model','model_avg','optimizer','scheduler','rank_states','contract']:identical(a[key],b[key],key)
assert a['world_size']==b['world_size']==1
assert a['model']['acoustic.ctc_output.0.weight'].shape[0]==105
(p/'SINGLE_RESUME_PASS.json').write_text(json.dumps(dict(world_size=1,bitwise_identical=True,head_dimension=105))+'\n')
PY
