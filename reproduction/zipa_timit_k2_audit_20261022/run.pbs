set -euo pipefail
cd /work/gm64/m64000/OTTC
export PYTHONPATH="$PWD/reproduction/vendor:$PWD/reproduction:$PWD:/work/gm64/m64000/zipa/mfa_miyabi_20260922/python_site"
export LD_LIBRARY_PATH=/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/lib
export PYTHONDONTWRITEBYTECODE=1 WANDB_MODE=disabled OTTC_EVAL_UPLOAD=0 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 CUDA_VISIBLE_DEVICES=0
export NUMBA_CACHE_DIR=/tmp/zipa_k2_numba_${PBS_JOBID} MPLCONFIGDIR=/tmp/zipa_k2_mpl_${PBS_JOBID}
nvidia-smi
