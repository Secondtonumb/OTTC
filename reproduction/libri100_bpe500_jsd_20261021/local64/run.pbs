#!/bin/bash
#PBS -N libri100_local64
#PBS -q regular-g
#PBS -W group_list=gm64
#PBS -l select=1:ncpus=32:mpiprocs=1
#PBS -l walltime=04:00:00
#PBS -j oe
set -euo pipefail
: "${PBS_JOBID:?PBS allocation required}"
case "${LIBRI_RECIPE:-}" in ottc_jsd|spottc_jsd) ;; *) exit 2 ;; esac
cd /work/gm64/m64000/OTTC
source reproduction/libri960_continue5_20261017/environment.sh
export CUDA_VISIBLE_DEVICES=0 OTTC_EVAL_UPLOAD=0
export NCCL_DEBUG=WARN NCCL_IB_DISABLE=1 NCCL_NET=Socket NCCL_NET_PLUGIN=none
SECONDS=0
recipe="$PWD/reproduction/libri100_bpe500_jsd_20261021/local64"
telemetry="$recipe/jobs/gpu_${PBS_JOBID}_${LIBRI_RECIPE}.csv"
nvidia-smi --query-gpu=timestamp,index,name,utilization.gpu,memory.used,memory.total,power.draw --format=csv -l 10 > "$telemetry" &
sampler=$!
trap 'kill "$sampler" 2>/dev/null || true' EXIT
CUDA_VISIBLE_DEVICES='' "$LIBRI_PYTHON" -u "$recipe/train.py" --check
remaining=$((10800 - SECONDS))
if (( remaining < 180 )); then exit 75; fi
"$LIBRI_PYTHON" -m torch.distributed.run --standalone --nnodes=1 --nproc_per_node=1 \
    "$recipe/train.py" --recipe "$LIBRI_RECIPE" --max-seconds "$remaining"
if [[ ! -f "$recipe/models/$LIBRI_RECIPE/BENCHMARK_COMPLETE.json" ]]; then exit 75; fi