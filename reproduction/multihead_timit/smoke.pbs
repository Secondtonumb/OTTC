#!/usr/bin/env bash
#PBS -N timit_fourhead_smoke
#PBS -q debug-g
#PBS -W group_list=gm64
#PBS -l select=1:ncpus=32:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
cd /work/gm64/m64000/OTTC
export PYTHONPATH=/work/gm64/m64000/OTTC/reproduction/vendor:/work/gm64/m64000/OTTC
export LD_LIBRARY_PATH=/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/lib:${LD_LIBRARY_PATH:-}
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 OMP_NUM_THREADS=4
export WANDB_MODE=online WANDB_LOG_MODEL=false WANDB_WATCH=false
export CUDA_VISIBLE_DEVICES=0
PY=/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/bin/python
"$PY" -u reproduction/check_multihead.py
for objective in ctc ce jsd_upstream; do
  "$PY" -u reproduction/train_multihead.py \
    --data reproduction/multihead_timit/data --objective "$objective" \
    --output "reproduction/multihead_timit/validation/lv60_${objective}" \
    --train-limit 8 --eval-limit 2 --max-steps 2 \
    --batch-size 2 --effective-batch-size 4
done
"$PY" -c 'from pathlib import Path; Path("reproduction/multihead_timit/validation/GPU_SMOKE_COMPLETE").write_text("all three objectives passed\n")'
