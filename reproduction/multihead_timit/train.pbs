#!/usr/bin/env bash
#PBS -N timit_fourhead_three_losses
#PBS -q regular-g
#PBS -W group_list=gm64
#PBS -l select=3:ncpus=32:mpiprocs=1
#PBS -l walltime=04:00:00
#PBS -j oe
set -euo pipefail
cd /work/gm64/m64000/OTTC
test -f reproduction/multihead_timit/validation/GPU_SMOKE_COMPLETE
if [[ -f reproduction/multihead_timit/models/ctc/TRAIN_COMPLETE.json &&
      -f reproduction/multihead_timit/models/ce/TRAIN_COMPLETE.json &&
      -f reproduction/multihead_timit/models/jsd_upstream/TRAIN_COMPLETE.json ]]; then
  /work/gm64/m64000/miniforge3/envs/sb_k2_cuda/bin/python reproduction/multihead_timit/summarize.py
  exit
fi
export PYTHONPATH=/work/gm64/m64000/OTTC/reproduction/vendor:/work/gm64/m64000/OTTC
export LD_LIBRARY_PATH=/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/lib:${LD_LIBRARY_PATH:-}
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 OMP_NUM_THREADS=4
export WANDB_MODE=online WANDB_LOG_MODEL=false WANDB_WATCH=false
export OMPI_MCA_mca_base_env_list='PYTHONPATH;LD_LIBRARY_PATH;HF_HUB_OFFLINE;TRANSFORMERS_OFFLINE;OMP_NUM_THREADS;WANDB_MODE;WANDB_LOG_MODEL;WANDB_WATCH'
mpirun -np 3 --map-by ppr:1:node --bind-to none bash reproduction/multihead_timit/train_rank.sh
/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/bin/python reproduction/multihead_timit/summarize.py
