#!/usr/bin/env bash
#PBS -N ottc_frozen_probe
#PBS -q debug-g
#PBS -W group_list=gm64
#PBS -l select=1:ncpus=32:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
cd /work/gm64/m64000/OTTC
export PYTHONPATH=/work/gm64/m64000/OTTC/reproduction/vendor:/work/gm64/m64000/OTTC
export LD_LIBRARY_PATH=/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/lib:${LD_LIBRARY_PATH:-}
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 OMP_NUM_THREADS=4 CUDA_VISIBLE_DEVICES=0 WANDB_MODE=online
mkdir -p reproduction/english_suite/throughput_probe_frozen
nvidia-smi --query-gpu=timestamp,name,utilization.gpu,utilization.memory,memory.used,memory.total,power.draw,power.limit --format=csv -l 2 > reproduction/english_suite/throughput_probe_frozen/gpu.csv &
monitor_pid=$!
trap 'kill "$monitor_pid" 2>/dev/null || true' EXIT
/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/bin/python -u reproduction/english_suite/benchmark_libri.py --frozen
