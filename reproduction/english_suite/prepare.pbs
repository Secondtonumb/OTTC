#!/usr/bin/env bash
#PBS -N ottc_libri_prepare
#PBS -q debug-g
#PBS -W group_list=gm64
#PBS -l select=1:ncpus=32:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
cd /work/gm64/m64000/OTTC
export PYTHONPATH=/work/gm64/m64000/OTTC/reproduction/vendor:/work/gm64/m64000/OTTC
export LD_LIBRARY_PATH=/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/lib:${LD_LIBRARY_PATH:-}
export OMP_NUM_THREADS=4 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
task_python=/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/bin/python
"$task_python" -u reproduction/prepare_multihead_libri.py --dataset libri960 --output reproduction/multihead_libri960/data
"$task_python" reproduction/english_suite/audit_data.py
