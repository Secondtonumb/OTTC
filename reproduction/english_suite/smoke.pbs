#!/usr/bin/env bash
#PBS -N ottc_libri_smoke
#PBS -q debug-g
#PBS -W group_list=gm64
#PBS -l select=1:ncpus=32:mpiprocs=1
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
cd /work/gm64/m64000/OTTC
export PYTHONPATH=/work/gm64/m64000/OTTC/reproduction/vendor:/work/gm64/m64000/OTTC
export LD_LIBRARY_PATH=/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/lib:${LD_LIBRARY_PATH:-}
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 OMP_NUM_THREADS=4 CUDA_VISIBLE_DEVICES=0
export WANDB_MODE=online WANDB_LOG_MODEL=false WANDB_WATCH=false
export WANDB_RUN_GROUP=libri_fourphonesets_smoke
task_python=/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/bin/python
"$task_python" reproduction/check_multihead.py
for objective in ctc ce jsd_upstream; do
  "$task_python" -u reproduction/train_multihead.py \
    --data reproduction/multihead_libri100/data --objective "$objective" \
    --output "reproduction/english_suite/validation/${objective}" --max-steps 2 \
    --train-limit 64 --eval-limit 2 --max-duration 0 --batch-size 4 --effective-batch-size 64
done
"$task_python" - <<'PY'
import json, math
from pathlib import Path
base=Path('reproduction/english_suite')
for name in ('ctc','ce','jsd_upstream'):
    out=base/'validation'/name
    marker=json.loads((out/'TRAIN_COMPLETE.json').read_text())
    assert marker['smoke'] and marker['steps']==2
    metrics=json.loads((out/'dev_metrics.json').read_text())
    assert math.isfinite(metrics['eval_loss'])
(base/'GPU_SMOKE_COMPLETE.json').write_text(json.dumps({'passed':True,'models':['ctc','ce','jsd_upstream'],'official_lv60':True})+'\n')
PY
