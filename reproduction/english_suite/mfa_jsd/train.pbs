#!/usr/bin/env bash
#PBS -N zapformer_ottc_jsd
#PBS -q small-g
#PBS -W group_list=gm64
#PBS -l select=8:ncpus=16:mpiprocs=1
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail
suite=/work/gm64/m64000/OTTC/reproduction/english_suite
export MFA_JSD_OUTPUT="${MFA_JSD_OUTPUT:-$suite/mfa_models/ottc_jsd_upstream}"
test -s "$suite/mfa_jsd/validation/SMOKE_PASS.json"
sha256sum -c "$suite/mfa_runtime.sha256"
mkdir -p "$MFA_JSD_OUTPUT"
exec 9> "$MFA_JSD_OUTPUT/.training.lock"
flock 9
if [[ -f "$MFA_JSD_OUTPUT/TRAIN_COMPLETE.json" ]]; then exit 0; fi
awk '!seen[$0]++' "${PBS_NODEFILE:?}" > "$MFA_JSD_OUTPUT/nodes"
export MFA_MASTER_ADDR=$(head -1 "$MFA_JSD_OUTPUT/nodes")
export MFA_MASTER_PORT=$((29500 + ${PBS_JOBID%%.*} % 1000))
export WANDB_RUN_GROUP=mfa_english_zapformer_jsd_upstream
export OMPI_MCA_mca_base_env_list='MFA_MASTER_ADDR;MFA_MASTER_PORT;MFA_JSD_OUTPUT;WANDB_RUN_GROUP;PATH;LD_LIBRARY_PATH'
mpirun -np 8 --hostfile "$MFA_JSD_OUTPUT/nodes" --map-by ppr:1:node --bind-to none bash "$suite/mfa_jsd/worker.sh"
