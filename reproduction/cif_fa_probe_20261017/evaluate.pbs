#!/bin/bash
#PBS -N cif_fa_probe
#PBS -q short-g
#PBS -W group_list=gm64
#PBS -l select=1:ncpus=16:mpiprocs=1
#PBS -l walltime=00:15:00
#PBS -j oe
#PBS -o /work/gm64/m64000/OTTC/reproduction/cif_fa_probe_20261017/job.log
set -euo pipefail
cd /work/gm64/m64000/OTTC
export PYTHONPATH="$PWD/reproduction/vendor:$PWD:/work/gm64/m64000/zipa/mfa_miyabi_20260922/python_site"
export LD_LIBRARY_PATH="/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/lib:${LD_LIBRARY_PATH:-}"
export PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1
export CUDA_VISIBLE_DEVICES=0
nvidia-smi --query-gpu=timestamp,index,utilization.gpu,memory.used,memory.total --format=csv -l 1 > reproduction/cif_fa_probe_20261017/telemetry.csv &
probe_telemetry=$!
trap 'kill "$probe_telemetry" 2>/dev/null || true' EXIT
/work/gm64/m64000/miniforge3/envs/sb_k2_cuda/bin/python -u -m reproduction.cif_fa_probe_20261017.evaluate
