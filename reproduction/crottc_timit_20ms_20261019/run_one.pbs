#!/bin/bash
#PBS -N timit_crottc20
#PBS -q regular-g
#PBS -W group_list=gm64
#PBS -l select=1:ncpus=32:mpiprocs=1
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
SECONDS=0
cd /work/gm64/m64000/OTTC
source reproduction/libri960_continue5_20261017/environment.sh
export CUDA_VISIBLE_DEVICES=0
export WANDB_RUN_GROUP=crottc_timit_20ms_20261019
crottc_root="$PWD/reproduction/crottc_timit_20ms_20261019"
crottc_recipe=${CROTTC_RECIPE:?Exact independent recipe required}
mkdir -p "$crottc_root/profiles/$crottc_recipe" "$crottc_root/models/$crottc_recipe"
exec 9>"$crottc_root/models/$crottc_recipe/.job.lock"
flock -n 9 || exit 0
nvidia-smi --query-gpu=timestamp,index,utilization.gpu,memory.used,power.draw --format=csv -l 5 >> "$crottc_root/profiles/$crottc_recipe/telemetry.csv" &
crottc_telemetry=$!
trap 'kill "$crottc_telemetry" 2>/dev/null || true' EXIT
"$LIBRI_PYTHON" -u "$crottc_root/validate.py" --device cuda
if ! "$LIBRI_PYTHON" -c 'import json,sys; from pathlib import Path; from reproduction.crottc_timit_20ms_20261019.common import source_hashes; p=Path(sys.argv[1]); sys.exit(0 if p.exists() and json.loads(p.read_text())["source_sha256"]==source_hashes() else 1)' "$crottc_root/profiles/$crottc_recipe/PASS.json"; then
    "$LIBRI_PYTHON" -u "$crottc_root/train.py" --recipe "$crottc_recipe" --profile
fi
crottc_train_seconds=$((2400 - SECONDS))
if [ "$crottc_train_seconds" -lt 60 ]; then crottc_train_seconds=60; fi
"$LIBRI_PYTHON" -u "$crottc_root/train.py" --recipe "$crottc_recipe" --max-seconds "$crottc_train_seconds"
if [ ! -f "$crottc_root/models/$crottc_recipe/BENCHMARK_COMPLETE.json" ]; then
    /opt/pbs/bin/qsub -v "CROTTC_RECIPE=$crottc_recipe" -o "$crottc_root/resume_${PBS_JOBID}.log" "$crottc_root/run_one.pbs" > "$crottc_root/models/$crottc_recipe/continuation_job.txt"
fi
