#!/bin/bash
#PBS -N buckeye_single_ot
#PBS -q regular-g
#PBS -W group_list=gm64
#PBS -l select=1:ncpus=32:mpiprocs=1
#PBS -l walltime=04:00:00
#PBS -j oe
set -euo pipefail
cd /work/gm64/m64000/OTTC
source reproduction/buckeye_singlehead_20261014/environment.sh
objective=${BUCKEYE_OBJECTIVE:?Specify ce or jsd_upstream}
exec 9> "reproduction/buckeye_singlehead_20261014/.${objective}.lock"
flock -n 9
"$BUCKEYE_PYTHON" -u reproduction/buckeye_singlehead_20261014/train.py --objective "$objective"
"$BUCKEYE_PYTHON" -u reproduction/buckeye_singlehead_20261014/evaluate.py --objective "$objective"
if [[ -f reproduction/buckeye_singlehead_20261014/evaluation/ce/EVAL_COMPLETE.json && -f reproduction/buckeye_singlehead_20261014/evaluation/jsd_upstream/EVAL_COMPLETE.json ]]; then
    exec 8> reproduction/buckeye_singlehead_20261014/.report.lock
    flock 8
    "$BUCKEYE_PYTHON" -u reproduction/buckeye_singlehead_20261014/summarize.py
fi
